# install.sh erzeugt DB_CFFI_TOKEN automatisch. Bei manueller Installation
# CHANGE_ME vor dem ersten Start durch einen zufälligen Wert ersetzen.
DB_CFFI_TOKEN=CHANGE_ME

# Optional: eigener Stay22 API-Key für die Hotelsuche.
STAY22_API_KEY=

# Sicherer Default: nur lokal erreichbar. Für LAN-Zugriff bewusst auf 0.0.0.0 setzen.
FAREWEAVE_BIND_HOST=127.0.0.1
FAREWEAVE_PORT=8791
